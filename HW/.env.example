SECRET_KEY=change-this-to-a-random-32byte-string

# Primary admin credentials
ADMIN_USERNAME=admin
# Hash created with Werkzeug generate_password_hash (method pbkdf2:sha256)
ADMIN_PASSWORD_HASH=

# Optional: default role for first login users
DEFAULT_ROLE=user

# Self-registration
REGISTER_OPEN=false
REGISTER_INVITE_CODE=

# Password reset
RESET_TOKEN_TTL_MIN=20
RESET_DEV_SHOW_TOKEN=false
# Safe local defaults
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
